    {"code":"vm.stackUnderflow","producers":["vm"],"requiredParams":[],"optionalParams":[],"rangePolicy":"no user source range","relatedLocationPolicy":"none","backendOwnership":"reserved-contract","parityScope":"deferred-no-trigger","userVisible":false},
    {"code":"vm.stackOverflow","producers":["vm"],"requiredParams":[],"optionalParams":[],"rangePolicy":"no user source range","relatedLocationPolicy":"none","backendOwnership":"reserved-contract","parityScope":"deferred-no-trigger","userVisible":false}
