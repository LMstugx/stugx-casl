{
  "baselineVersion": "diagnostic-localization-v1",
  "supportedLocales": ["en", "ja", "zh-CN"],
  "fallbackLocale": "en",
  "producers": ["casl-parser", "assembler", "cpp-lexer", "cpp-parser", "semantic", "transpiler", "vm", "wasm-adapter"],
  "sourceRangeContract": {
    "lineColumnBasis": "1-based",
    "offsetBasis": "0-based UTF-16 code units in TypeScript",
    "endSemantics": "exclusive",
    "insertionRange": "start equals end"
  },
  "diagnosticDefaults": {
    "localeCoverage": ["en", "ja", "zh-CN"],
    "legacyCompatibility": true,
    "userVisible": true,
    "rawContextPolicy": "collapsed-details-only"
  },
  "legacyCompatibility": {
    "messageOnly": true,
    "messageWithRange": true,
    "missingProducerInference": "code namespace only",
    "unknownCode": "safe legacy fallback",
    "partialStructuredPayload": "safe legacy fallback",
    "oldWasmJson": true
  },
  "internalRawPolicy": {
    "includedAsLocalizedDiagnostics": false,
    "stableOuterWrapperAllowed": true,
    "rawDetails": "sanitized collapsed developer detail",
    "prohibitedPrimaryContent": ["stack trace", "local path", "serialized payload", "internal AST dump"]
  },
  "structuredDiagnostics": [
    {"code":"assembler.missingStart","producers":["assembler"],"requiredParams":[],"optionalParams":[],"rangePolicy":"first meaningful insertion","relatedLocationPolicy":"none","backendOwnership":"shared-ts-cpp-wasm","parityScope":"shared CASL"},
    {"code":"assembler.missingEnd","producers":["assembler"],"requiredParams":[],"optionalParams":[],"rangePolicy":"EOF insertion","relatedLocationPolicy":"none","backendOwnership":"shared-ts-cpp-wasm","parityScope":"shared CASL"},
    {"code":"assembler.unknownOpcode","producers":["casl-parser"],"requiredParams":["opcode"],"optionalParams":["line"],"rangePolicy":"opcode token","relatedLocationPolicy":"none","backendOwnership":"shared-ts-cpp-wasm","parityScope":"shared CASL"},
    {"code":"assembler.unknownSymbol","producers":["assembler"],"requiredParams":["symbol"],"optionalParams":["line"],"rangePolicy":"symbol token","relatedLocationPolicy":"none","backendOwnership":"shared-ts-cpp-wasm","parityScope":"shared CASL"},
    {"code":"assembler.duplicateLabel","producers":["assembler"],"requiredParams":["label"],"optionalParams":["duplicateLine","firstLine"],"rangePolicy":"duplicate label token","relatedLocationPolicy":"first declaration when reliable","backendOwnership":"shared-ts-cpp-wasm","parityScope":"shared CASL"},
    {"code":"assembler.invalidRegister","producers":["assembler"],"requiredParams":["register"],"optionalParams":[],"rangePolicy":"register token","relatedLocationPolicy":"none","backendOwnership":"shared-ts-cpp-wasm","parityScope":"shared CASL"},
    {"code":"assembler.invalidIndexRegister","producers":["assembler"],"requiredParams":["indexRegister"],"optionalParams":[],"rangePolicy":"index register token","relatedLocationPolicy":"none","backendOwnership":"shared-ts-cpp-wasm","parityScope":"shared CASL"},
    {"code":"assembler.malformedOperandList","producers":["assembler"],"requiredParams":[],"optionalParams":[],"rangePolicy":"malformed comma or operand boundary","relatedLocationPolicy":"none","backendOwnership":"shared-ts-cpp-wasm","parityScope":"shared CASL"},
    {"code":"assembler.invalidOperandCount","producers":["assembler"],"requiredParams":["mnemonic"],"optionalParams":["actualCount","expectedCount"],"rangePolicy":"instruction line or retained mnemonic","relatedLocationPolicy":"none","backendOwnership":"shared-ts-cpp-wasm","parityScope":"shared CASL"},
    {"code":"assembler.addressOutOfRange","producers":["assembler"],"requiredParams":[],"optionalParams":["maximum","minimum","value"],"rangePolicy":"rejected token when retained; otherwise undefined","relatedLocationPolicy":"none","backendOwnership":"shared-ts-cpp-wasm","parityScope":"partial metadata"},
    {"code":"assembler.literalOutOfRange","producers":["assembler"],"requiredParams":[],"optionalParams":["maximum","minimum","value"],"rangePolicy":"literal token when retained; otherwise undefined","relatedLocationPolicy":"none","backendOwnership":"shared-ts-cpp-wasm","parityScope":"partial metadata"},
    {"code":"assembler.missingOpcode","producers":["casl-parser"],"requiredParams":[],"optionalParams":["label"],"rangePolicy":"line-end insertion","relatedLocationPolicy":"none","backendOwnership":"shared-ts-cpp-wasm","parityScope":"shared CASL"},
    {"code":"assembler.invalidLiteral","producers":["assembler"],"requiredParams":["literal"],"optionalParams":[],"rangePolicy":"literal token","relatedLocationPolicy":"none","backendOwnership":"shared-ts-cpp-wasm","parityScope":"shared CASL"},
    {"code":"assembler.missingOperand","producers":["assembler"],"requiredParams":["mnemonic"],"optionalParams":[],"rangePolicy":"line-end insertion","relatedLocationPolicy":"none","backendOwnership":"shared-ts-cpp-wasm","parityScope":"shared CASL"},
    {"code":"assembler.unexpectedTrailingOperand","producers":["assembler"],"requiredParams":["mnemonic","operand"],"optionalParams":[],"rangePolicy":"trailing operand token","relatedLocationPolicy":"none","backendOwnership":"shared-ts-cpp-wasm","parityScope":"shared CASL"},
