    {"code":"semantic.floatingLiteralOutOfRange","producers":["semantic"],"requiredParams":["literal"],"optionalParams":[],"rangePolicy":"floating literal token","relatedLocationPolicy":"none","backendOwnership":"ts-only","parityScope":"TypeScript C++ subset only"},
    {"code":"semantic.unsupportedFloatingSuffix","producers":["semantic"],"requiredParams":["literal","suffix"],"optionalParams":[],"rangePolicy":"floating literal token","relatedLocationPolicy":"none","backendOwnership":"ts-only","parityScope":"TypeScript C++ subset only"},
    {"code":"semantic.unsupportedDoubleArray","producers":["semantic"],"requiredParams":["variable"],"optionalParams":[],"rangePolicy":"double array declaration","relatedLocationPolicy":"none","backendOwnership":"ts-only","parityScope":"TypeScript C++ subset only"},
