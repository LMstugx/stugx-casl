    {"code":"transpiler.unsupportedCallArgument","producers":["transpiler"],"requiredParams":["argumentCount"],"optionalParams":["function"],"rangePolicy":"unsupported argument expression","relatedLocationPolicy":"none","backendOwnership":"ts-only","parityScope":"TypeScript C++ subset only"},
    {"code":"transpiler.unsupportedExpression","producers":["transpiler"],"requiredParams":["construct"],"optionalParams":[],"rangePolicy":"construct line or token when reliable","relatedLocationPolicy":"none","backendOwnership":"ts-only","parityScope":"TypeScript C++ subset only"},
    {"code":"transpiler.generatedLabelConflict","producers":["transpiler"],"requiredParams":["function","label"],"optionalParams":[],"rangePolicy":"conflicting function declaration","relatedLocationPolicy":"first function declaration","backendOwnership":"ts-only","parityScope":"TypeScript C++ subset only"},
    {"code":"transpiler.internalLoweringFailure","producers":["transpiler"],"requiredParams":[],"optionalParams":[],"rangePolicy":"none; do not fabricate source mapping","relatedLocationPolicy":"none","backendOwnership":"ts-only","parityScope":"stable wrapper only"},
    {"code":"vm.notLoaded","producers":["vm"],"requiredParams":[],"optionalParams":[],"rangePolicy":"none unless reliable mapping exists","relatedLocationPolicy":"none","backendOwnership":"cpp-core-wasm","parityScope":"no mock diagnostic trigger"},
    {"code":"vm.stepLimitReached","producers":["vm"],"requiredParams":["stepLimit"],"optionalParams":[],"rangePolicy":"none unless reliable mapping exists","relatedLocationPolicy":"none","backendOwnership":"cpp-core-wasm","parityScope":"stable execution wrapper"},
    {"code":"vm.invalidInstruction","producers":["vm"],"requiredParams":[],"optionalParams":["address"],"rangePolicy":"none unless reliable mapping exists","relatedLocationPolicy":"none","backendOwnership":"cpp-core-wasm","parityScope":"stable execution wrapper"},
