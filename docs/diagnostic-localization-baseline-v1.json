    {"code":"semantic.breakOutsideLoop","producers":["semantic"],"requiredParams":[],"optionalParams":[],"rangePolicy":"break keyword","relatedLocationPolicy":"none","backendOwnership":"ts-only","parityScope":"TypeScript C++ subset only"},
    {"code":"semantic.continueOutsideLoop","producers":["semantic"],"requiredParams":[],"optionalParams":[],"rangePolicy":"continue keyword","relatedLocationPolicy":"none","backendOwnership":"ts-only","parityScope":"TypeScript C++ subset only"},
    {"code":"semantic.parameterLocalConflict","producers":["semantic"],"requiredParams":["variable"],"optionalParams":["function","localLine","parameterLine"],"rangePolicy":"conflicting local declaration","relatedLocationPolicy":"parameter declaration when reliable","backendOwnership":"ts-only","parityScope":"TypeScript C++ subset only"},
    {"code":"semantic.unsupportedMainParameters","producers":["semantic"],"requiredParams":["actualCount"],"optionalParams":[],"rangePolicy":"first parameter","relatedLocationPolicy":"none","backendOwnership":"ts-only","parityScope":"TypeScript C++ subset only"},
    {"code":"semantic.duplicateParameter","producers":["semantic"],"requiredParams":["variable"],"optionalParams":["function"],"rangePolicy":"duplicate parameter name","relatedLocationPolicy":"first declaration when reliable","backendOwnership":"ts-only","parityScope":"TypeScript C++ subset only"},
    {"code":"semantic.duplicateVariable","producers":["semantic"],"requiredParams":["variable"],"optionalParams":["function"],"rangePolicy":"duplicate variable name","relatedLocationPolicy":"first declaration when reliable","backendOwnership":"ts-only","parityScope":"TypeScript C++ subset only"},
    {"code":"semantic.unsupportedInitializer","producers":["semantic"],"requiredParams":["variable"],"optionalParams":[],"rangePolicy":"variable declaration name","relatedLocationPolicy":"none","backendOwnership":"ts-only","parityScope":"TypeScript C++ subset only"},
    {"code":"semantic.invalidCondition","producers":["semantic"],"requiredParams":["construct"],"optionalParams":[],"rangePolicy":"condition owner token when reliable","relatedLocationPolicy":"none","backendOwnership":"ts-only","parityScope":"TypeScript C++ subset only"},
    {"code":"semantic.integerLiteralOutOfRange","producers":["semantic"],"requiredParams":["literal"],"optionalParams":[],"rangePolicy":"integer literal token","relatedLocationPolicy":"none","backendOwnership":"ts-only","parityScope":"TypeScript C++ subset only"},
    {"code":"semantic.forwardDeclarationUnsupported","producers":["semantic"],"requiredParams":["function"],"optionalParams":[],"rangePolicy":"call target identifier","relatedLocationPolicy":"none","backendOwnership":"ts-only","parityScope":"TypeScript C++ subset only"},
