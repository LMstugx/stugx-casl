    {"code":"semantic.unsupportedDoubleComparison","producers":["semantic"],"requiredParams":["operator"],"optionalParams":[],"rangePolicy":"comparison expression","relatedLocationPolicy":"none","backendOwnership":"ts-only","parityScope":"TypeScript C++ subset only"},
    {"code":"semantic.unsupportedDoubleParameter","producers":["semantic"],"requiredParams":["function","parameter"],"optionalParams":[],"rangePolicy":"double parameter declaration or argument expression","relatedLocationPolicy":"none","backendOwnership":"ts-only","parityScope":"TypeScript C++ subset only"},
    {"code":"semantic.unsupportedDoubleReturn","producers":["semantic"],"requiredParams":["function"],"optionalParams":[],"rangePolicy":"double return type or returned expression","relatedLocationPolicy":"none","backendOwnership":"ts-only","parityScope":"TypeScript C++ subset only"},
