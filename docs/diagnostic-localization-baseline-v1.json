    {"code":"cppParser.expectedToken","producers":["cpp-parser"],"requiredParams":["expectedToken"],"optionalParams":["actualToken"],"rangePolicy":"current token or EOF insertion","relatedLocationPolicy":"none","backendOwnership":"ts-only","parityScope":"TypeScript C++ subset only"},
    {"code":"cppParser.unterminatedBlock","producers":["cpp-lexer","cpp-parser"],"requiredParams":[],"optionalParams":["construct"],"rangePolicy":"EOF insertion","relatedLocationPolicy":"opening delimiter when reliable","backendOwnership":"ts-only","parityScope":"TypeScript C++ subset only"},
    {"code":"cppParser.missingSemicolon","producers":["cpp-parser"],"requiredParams":[],"optionalParams":[],"rangePolicy":"statement-end insertion","relatedLocationPolicy":"none","backendOwnership":"ts-only","parityScope":"TypeScript C++ subset only"},
    {"code":"cppParser.invalidFunctionDeclaration","producers":["cpp-parser"],"requiredParams":[],"optionalParams":["token"],"rangePolicy":"offending declaration token","relatedLocationPolicy":"none","backendOwnership":"ts-only","parityScope":"TypeScript C++ subset only"},
    {"code":"cppParser.invalidParameterList","producers":["cpp-parser"],"requiredParams":[],"optionalParams":["token"],"rangePolicy":"offending parameter token","relatedLocationPolicy":"none","backendOwnership":"ts-only","parityScope":"TypeScript C++ subset only"},
    {"code":"cppParser.invalidVariableDeclaration","producers":["cpp-parser"],"requiredParams":[],"optionalParams":["token"],"rangePolicy":"offending declaration token","relatedLocationPolicy":"none","backendOwnership":"ts-only","parityScope":"TypeScript C++ subset only"},
    {"code":"cppParser.invalidAssignment","producers":["cpp-parser"],"requiredParams":[],"optionalParams":["token"],"rangePolicy":"offending assignment token","relatedLocationPolicy":"none","backendOwnership":"ts-only","parityScope":"TypeScript C++ subset only"},
    {"code":"cppParser.invalidIfStatement","producers":["cpp-parser"],"requiredParams":[],"optionalParams":["token"],"rangePolicy":"offending if token","relatedLocationPolicy":"none","backendOwnership":"ts-only","parityScope":"TypeScript C++ subset only"},
    {"code":"cppParser.invalidForStatement","producers":["cpp-parser"],"requiredParams":[],"optionalParams":["token"],"rangePolicy":"offending for token","relatedLocationPolicy":"none","backendOwnership":"ts-only","parityScope":"TypeScript C++ subset only"},
    {"code":"cppParser.invalidCallExpression","producers":["cpp-parser"],"requiredParams":[],"optionalParams":["token"],"rangePolicy":"call target token","relatedLocationPolicy":"none","backendOwnership":"ts-only","parityScope":"TypeScript C++ subset only"},
    {"code":"cppParser.unsupportedExpression","producers":["cpp-parser"],"requiredParams":["token"],"optionalParams":[],"rangePolicy":"offending token","relatedLocationPolicy":"none","backendOwnership":"ts-only","parityScope":"TypeScript C++ subset only"},
    {"code":"cppParser.unsupportedOperator","producers":["cpp-parser"],"requiredParams":["operator"],"optionalParams":["construct"],"rangePolicy":"operator token","relatedLocationPolicy":"none","backendOwnership":"ts-only","parityScope":"TypeScript C++ subset only"},
    {"code":"semantic.mainFunctionMissing","producers":["semantic"],"requiredParams":[],"optionalParams":[],"rangePolicy":"EOF or first declaration insertion","relatedLocationPolicy":"none","backendOwnership":"ts-only","parityScope":"TypeScript C++ subset only"},
    {"code":"semantic.duplicateFunction","producers":["semantic"],"requiredParams":["function"],"optionalParams":["duplicateLine","firstLine"],"rangePolicy":"duplicate function name","relatedLocationPolicy":"first declaration","backendOwnership":"ts-only","parityScope":"TypeScript C++ subset only"},
    {"code":"semantic.unknownFunction","producers":["semantic"],"requiredParams":["function"],"optionalParams":[],"rangePolicy":"call target identifier","relatedLocationPolicy":"none","backendOwnership":"ts-only","parityScope":"TypeScript C++ subset only"},
    {"code":"semantic.unknownVariable","producers":["semantic"],"requiredParams":["variable"],"optionalParams":["function"],"rangePolicy":"identifier token","relatedLocationPolicy":"none","backendOwnership":"ts-only","parityScope":"TypeScript C++ subset only"},
