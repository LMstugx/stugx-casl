{
  "baselineVersion": 1,
  "purpose": "validation-snapshot-only",
  "runtimeSourceOfTruth": "src/examples/learningLessons.ts and src/lessonProgress",
  "storageKey": "stugx.casl.lesson-progress.v1",
  "maxPayloadBytes": 65536,
  "limits": {
    "maxLessonEntries": 256,
    "maxStepsPerLesson": 256,
    "maxIdLength": 128
  },
  "persistedFields": [
    "lessonId",
    "exampleId",
    "progressCompatibilityVersion",
    "completedStepIds"
  ],
  "identityPolicy": {
    "lessonIdentity": "explicit-canonical-lesson-id",
    "stepIdentity": "explicit-lesson-local-step-id",
    "builtInOnly": true,
    "arrayIndexIdentity": false,
    "textIdentity": false,
    "localeIdentity": false,
    "sourceHashIdentity": false
  },
  "registrySnapshot": [
