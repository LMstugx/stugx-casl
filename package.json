{
  "name": "casl-studio-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:wasm": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:VITE_CORE_BACKEND='wasm'; pnpm exec vite --host 127.0.0.1\"",
    "build": "node scripts/build-production.mjs",
    "build:web": "tsc -b && vite build",
    "build:tauri:frontend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-tauri-frontend.ps1",
    "build:production": "node scripts/build-production.mjs",
    "build:pages": "bash scripts/build-cloudflare-pages.sh",
    "build:wasm": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-wasm.ps1",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:wasm": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:VITE_CORE_BACKEND='wasm'; pnpm exec vitest run src/tests/wasmCoreAdapter.test.ts\"",
    "test:e2e": "playwright test",
    "test:e2e:wasm": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:E2E_BACKEND='wasm'; pnpm exec playwright test tests/e2e/wasm-smoke.spec.ts\"",
    "test:e2e:production": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-production.ps1 -BasePath / -Port 5180",
    "test:e2e:production:subpath": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-production.ps1 -BasePath /stugx-casl/ -Port 5181",
    "test:e2e:deployed": "node scripts/test-deployed.mjs",
    "verify:deployed": "node scripts/verify-deployed-pages.mjs",
    "package:production": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-production.ps1",
    "visual:review": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:E2E_BACKEND='visual-review'; pnpm exec playwright test tests/e2e/visual-review.spec.ts\"",
    "visual:capture": "powershell -ExecutionPolicy Bypass -File scripts/capture-visual-review.ps1",
    "visual:serve": "powershell -ExecutionPolicy Bypass -File scripts/serve-visual-review.ps1",
    "tauri:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-tauri-demo.ps1 -Dev",
    "tauri:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-tauri-demo.ps1",
    "tauri:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-tauri-demo.ps1",
    "tauri:build:demo": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-tauri-demo.ps1"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "2.11.1",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.52.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "22.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  }
}
