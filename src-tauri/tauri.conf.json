{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "stugx.CASL",
  "version": "0.1.0",
  "identifier": "com.stugx.casl",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "pnpm dev:wasm",
    "beforeBuildCommand": "pnpm build:tauri:frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "stugx.CASL",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 700,
        "resizable": true,
        "maximizable": true,
        "devtools": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-src 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
